#!/usr/bin/env bash
set -euo pipefail

# Authenticate before reading the secret. `op signin` is idempotent and uses
# either configured desktop app integration or a standalone CLI session.
OP_SIGNIN="$(op signin)"
eval "$OP_SIGNIN"
unset OP_SIGNIN
OP_ITEM='op://Private/Dev Key - Strappy Github'
GITHUB_TOKEN="$(op read "$OP_ITEM/GITHUB_TOKEN")"
OPENROUTER_API_KEY="$(op read "$OP_ITEM/OPENROUTER_API_KEY")"
STRAPPY_USER_WHITELIST="$(op read "$OP_ITEM/STRAPPY_USER_WHITELIST")"
STRAPPY_GIT_NAME="$(op read "$OP_ITEM/STRAPPY_GIT_NAME")"
STRAPPY_GIT_EMAIL="$(op read "$OP_ITEM/STRAPPY_GIT_EMAIL")"
unset OP_ITEM
export GITHUB_TOKEN OPENROUTER_API_KEY STRAPPY_USER_WHITELIST STRAPPY_GIT_NAME STRAPPY_GIT_EMAIL

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

exec docker run --rm -it \
  --env GITHUB_TOKEN \
  --env OPENROUTER_API_KEY \
  --env STRAPPY_USER_WHITELIST \
  --env STRAPPY_GIT_NAME \
  --env STRAPPY_GIT_EMAIL \
  --publish 0.0.0.0:3000:3000 \
  --volume "$HOME/.strappy:/root" \
  --volume "$REPO_DIR:/repo/strappy-git" \
  --workdir /repo/strappy-git \
  --entrypoint /bin/bash \
  ghcr.io/jeffreybergier/altivec-intelligence:latest \
  -lc 'npm install --no-fund --no-audit && npm run build && exec npm start'
