{
  "name": "strappy-git",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GitHub-driven AI agent harness: watches whitelisted repos and runs ISO 9001-style job process maps through pi.dev + OpenRouter.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.3",
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@octokit/rest": "^22.0.1",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "typebox": "^1.3.18"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild": true,
    "protobufjs": true,
    "@google/genai": false
  }
}
